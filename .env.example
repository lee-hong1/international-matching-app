# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Toss Payments ─────────────────────────────────────────────────────────────
TOSS_SECRET_KEY=test_sk_...
TOSS_CLIENT_KEY=test_ck_...

# ── Firebase (FCM push notifications) ────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ── WebRTC TURN Server ────────────────────────────────────────────────────────
# TURN_SECRET is used to generate short-lived HMAC credentials (RFC 5389).
# Keep this secret — never expose it to the client.
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_SECRET=your-random-32-char-secret-here

# ── Rate Limiting (Upstash Redis) — optional ──────────────────────────────────
# If not set, an in-memory fallback is used (single-process, resets on restart).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── Click Tracking ────────────────────────────────────────────────────────────
# Salt for IP anonymization in shop link click logs.
CLICK_SALT=change-me-to-random-string

# ── PWA Build Versioning ──────────────────────────────────────────────────────
# Injected automatically in CI (e.g. Vercel uses VERCEL_GIT_COMMIT_SHA).
# Set manually for local dev if needed.
NEXT_PUBLIC_BUILD_ID=

# ── Email (Resend — preferred) ────────────────────────────────────────────────
# Setup: https://resend.com → Domains → Add globalmatch.app
# DNS: TXT v=spf1 include:_spf.resend.com ~all
#      CNAME resend._domainkey.globalmatch.app → verify in Resend dashboard
# FROM address: noreply@globalmatch.app
RESEND_API_KEY=re_your_key_here
# Alternative: SendGrid
# SENDGRID_API_KEY=SG.your_key_here

# ── Internal API Auth ─────────────────────────────────────────────────────────
# Used by /api/emails/* internal endpoints (must match SUPABASE_SERVICE_ROLE_KEY)
# INTERNAL_SERVICE_KEY=same_as_supabase_service_role_key

# ── Platform Commission Rate ──────────────────────────────────────────────────
# Fraction of gross booking amount taken as platform fee (default: 0.15 = 15%).
PLATFORM_COMMISSION_RATE=0.15

# ── Admin API ─────────────────────────────────────────────────────────────────
# Used by /api/admin/** endpoints. Keep this secret and rotate regularly.
ADMIN_API_KEY=your_random_admin_api_key_here
